{
  "name": "@claasahl/spotware-adapter",
  "version": "3.2.0",
  "description": "Protocol Buffers and Data Models for Spotware Open API 2.0",
  "main": "build/index.js",
  "private": false,
  "scripts": {
    "generate": "ts-node src/generators/index.ts",
    "postgenerate": "prettier --write src/",
    "prepare": "npm run build",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "jest",
    "server": "ts-node src/examples/server.ts",
    "client": "ts-node src/examples/client.ts"
  },
  "keywords": [
    "spotware",
    "ctrader",
    "typescript",
    "protobuf"
  ],
  "author": {
    "name": "Claas Ahlrichs",
    "email": "claasahl@gmail.com",
    "url": "https://github.com/claasahl"
  },
  "repository": "github:claasahl/spotware-adapter",
  "bugs": {
    "url": "https://github.com/claasahl/spotware-adapter/issues"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.5.2",
    "create-typescript-project-dependencies": "^13.0.3",
    "dotenv": "^17.2.2",
    "jest": "^26.6.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">= 10.5.0",
    "npm": ">= 6.4.1"
  },
  "dependencies": {
    "@claasahl/spotware-protobuf": "^91.0.1",
    "debug": "^4.4.3",
    "pbf": "^4.0.1"
  }
}
